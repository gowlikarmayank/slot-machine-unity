# Unity .gitignore — https://github.com/github/gitignore/blob/main/Unity.gitignore

# ── Unity generated ──────────────────────────────────────────────────────────
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/*
![Bb]uild/WebGL/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# ── VisualStudio / Rider ──────────────────────────────────────────────────────
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ── WebGL build (exclude intermediate but keep final build) ───────────────────
# Uncomment to exclude WebGL build from repo (not recommended for submission):
# Build/WebGL/

# ── Crash logs ────────────────────────────────────────────────────────────────
sysinfo.txt
*.stackdump
